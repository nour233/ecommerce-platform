# DynamoDB Local
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=CommerceCraft
USE_MOCK_DB=false
DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# Replace this value with a long random string in .env.local.
SESSION_SECRET=replace-with-a-long-random-string

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=CommerceCraft <no-reply@example.com>
