# AWS DynamoDB (cloud deployment)
# Keep DYNAMODB_ENDPOINT unset: localhost is only for local development.
AWS_REGION=eu-west-1
DYNAMODB_TABLE_NAME=CommerceCraft
USE_MOCK_DB=false

# Generate a long unique value. Do not reuse the local-development secret.
SESSION_SECRET=replace-with-a-long-random-production-secret

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password-or-app-password
MAIL_FROM=CommerceCraft <no-reply@example.com>

# Cloudinary image uploads (free plan; use an unsigned preset limited to images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=commercecraft_uploads

# Use an IAM user or role limited to this DynamoDB table.
# These values are needed locally to run db:setup; add them as protected secrets in Vercel.
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
